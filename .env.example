# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/agenda_profesional?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="tu-secret-key-aqui-genera-una-segura"

# Email (Resend)
RESEND_API_KEY="re_tu_api_key_aqui"

# WhatsApp (Twilio o similar)
WHATSAPP_API_KEY="tu_whatsapp_api_key"
WHATSAPP_API_SECRET="tu_whatsapp_api_secret"
WHATSAPP_PHONE_NUMBER="+1234567890"

# Uploads
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=10485760
