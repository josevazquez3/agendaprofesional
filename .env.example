# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/agenda_profesional?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="tu-secret-key-aqui-genera-una-segura"

# Email (Resend) - Solo con esto ya se envían correos (remitente de prueba: onboarding@resend.dev)
RESEND_API_KEY="re_tu_api_key_aqui"
# Opcional: nombre del remitente
# EMAIL_FROM_NAME="Agenda Profesional"
# En producción: verifica tu dominio en https://resend.com y define el remitente:
# EMAIL_FROM="noreply@tudominio.com"

# WhatsApp (Twilio) - opcional; también se configura en Configuración > WhatsApp
# TWILIO_ACCOUNT_SID=ACxxxx
# TWILIO_AUTH_TOKEN=xxxx
# WHATSAPP_PHONE_NUMBER=+5491112345678
# O usar los mismos nombres (prioridad en la config de la app):
# WHATSAPP_ACCOUNT_SID=ACxxxx
# WHATSAPP_AUTH_TOKEN=xxxx
# WHATSAPP_PHONE_NUMBER=+5491112345678

# Uploads
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=10485760
